---
/*
  首頁活動預告：放在主視覺正下方，精簡橫幅（小張海報縮圖＋重點資訊）。點海報可開大圖。
  設定在 src/data/site.ts 的 eventPromo。網站是建置時產生的靜態頁面，
  所以除了建置時判斷，也在瀏覽器端判斷：過了 hideAfter 那天（台灣時間）就自動隱藏，不必重新發布。
*/
import { site } from "../data/site";
import { withBase } from "../utils/url";

const promo = site.eventPromo;
const todayTaipei = new Date(Date.now() + 8 * 3600 * 1000).toISOString().slice(0, 10);
const show = Boolean(promo.image) && todayTaipei <= promo.hideAfter;
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(promo.mapQuery)}`;
---

{show && (
  <section id="event" class="bg-ink-900 py-5 text-white sm:py-6" data-hide-after={promo.hideAfter}>
    <div class="mx-auto flex max-w-5xl items-center gap-4 px-4 sm:gap-6 sm:px-6 lg:px-8">
      <a
        href={withBase(promo.image)}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="放大查看活動海報"
        class="block w-24 shrink-0 sm:w-32"
      >
        <img
          src={withBase(promo.image)}
          alt={promo.alt}
          width={promo.width}
          height={promo.height}
          decoding="async"
          class="h-auto w-full rounded-xl shadow-lg"
        />
      </a>

      <div class="min-w-0 flex-1">
        <p class="inline-block rounded-full bg-accent-500 px-3 py-0.5 text-xs font-bold text-white">活動預告</p>
        <h2 class="mt-2 text-lg font-extrabold leading-snug text-primary-400 sm:text-2xl">{promo.heading}</h2>
        <ul class="mt-2 space-y-0.5 text-sm leading-relaxed text-ink-100 sm:text-base">
          {promo.details.map((item, index) => (
            <li class:list={{ "hidden sm:list-item": index >= 3 }}><span class="font-bold text-primary-400">{item.label}</span>　{item.value}</li>
          ))}
        </ul>
        <a
          href={mapHref}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-block rounded-full bg-primary-500 px-4 py-1.5 text-sm font-bold text-ink-900 hover:bg-primary-400"
        >
          📍 地圖導航
        </a>
      </div>
    </div>
  </section>
)}

<script>
  const event = document.getElementById("event");
  const hideAfter = event?.dataset.hideAfter;
  if (event && hideAfter) {
    const todayTaipei = new Date(Date.now() + 8 * 3600 * 1000).toISOString().slice(0, 10);
    if (todayTaipei > hideAfter) event.remove();
  }
</script>
