---
import { site } from "../data/site";
import { withBase } from "../utils/url";
---

<section id="hero" class="relative overflow-hidden bg-surface">
  <!-- 裝飾用漸層光暈，純 CSS，不需要圖片 -->
  <div
    class="pointer-events-none absolute -top-32 -right-32 h-96 w-96 rounded-full bg-primary-300/40 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <!--
    競選橫幅：手機版排在最上方，第一眼就看到號次與姓名；桌面版放右側。
    整張圖片完整顯示（不裁切）。換橫幅只需要把新圖片放到 public/images/，
    再改 site.ts 的 banner.image 檔名與 banner.width、banner.height。
  -->
  <div class="relative mx-auto grid max-w-7xl gap-8 px-4 py-6 sm:px-6 lg:grid-cols-2 lg:items-center lg:gap-12 lg:py-16 lg:px-8">
    <div class="hero-fade-in lg:order-2">
      <img
        src={withBase(site.banner.image)}
        alt={site.banner.alt}
        width={site.banner.width}
        height={site.banner.height}
        fetchpriority="high"
        decoding="async"
        class="h-auto w-full rounded-3xl shadow-xl"
      />
    </div>

    <div class="hero-fade-in-delayed lg:order-1">
      <p class="inline-block rounded-full bg-primary-100 px-4 py-1 text-sm font-bold text-primary-700">
        {site.candidate.role}・{site.candidate.party}
      </p>
      <h1 class="mt-4 text-xl font-bold text-ink-900 sm:text-2xl">{site.candidate.name}｜官方網站</h1>
      <p class="mt-3 text-3xl font-extrabold leading-tight text-ink-900 sm:text-4xl lg:text-5xl">
        {site.hero.slogan}
      </p>
      <p class="mt-4 text-lg leading-relaxed text-ink-600">
        {site.hero.subtitle}
      </p>

      <div class="mt-6 flex flex-wrap gap-4">
        <a
          href={site.hero.primaryCta.href}
          class="rounded-full bg-accent-500 px-8 py-3.5 text-base font-bold text-white shadow-lg shadow-accent-500/30 transition-transform hover:scale-105 hover:bg-accent-600"
        >
          {site.hero.primaryCta.label}
        </a>
        <a
          href={site.hero.secondaryCta.href}
          class="rounded-full border-2 border-ink-900 px-8 py-3.5 text-base font-bold text-ink-900 transition-colors hover:bg-ink-900 hover:text-white"
        >
          {site.hero.secondaryCta.label}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-fade-in {
    animation: hero-fade-up 0.7s ease-out both;
  }

  .hero-fade-in-delayed {
    animation: hero-fade-up 0.7s ease-out 0.15s both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fade-in,
    .hero-fade-in-delayed {
      animation: none;
    }
  }
</style>
