---
import { site } from "../data/site";
---

<section id="donate" class="py-20">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
    <!-- 捐款區塊 -->
    <div class="rounded-3xl bg-ink-900 p-8 text-white sm:p-10">
      <h2 class="text-2xl font-extrabold sm:text-3xl">{site.donation.heading}</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-200">{site.donation.description}</p>

      <!-- 政治獻金專戶資訊 -->
      <dl class="mt-8 divide-y divide-ink-700 rounded-2xl border-2 border-primary-500 bg-ink-800/60">
        <div class="px-5 py-4">
          <dt class="text-xs font-bold tracking-wider text-primary-400">戶名</dt>
          <dd class="mt-1 text-base font-bold leading-snug">{site.donation.account.name}</dd>
        </div>
        <div class="px-5 py-4">
          <dt class="text-xs font-bold tracking-wider text-primary-400">銀行</dt>
          <dd class="mt-1 text-base font-bold">
            {site.donation.account.bank}（代碼 {site.donation.account.bankCode}）
          </dd>
        </div>
        <div class="px-5 py-4">
          <dt class="text-xs font-bold tracking-wider text-primary-400">帳號</dt>
          <dd class="mt-1 flex flex-wrap items-center justify-between gap-3">
            <span class="font-mono text-2xl font-bold tracking-wide text-primary-400 sm:text-3xl">
              {site.donation.account.number}
            </span>
            <button
              type="button"
              id="copy-account"
              data-copy={site.donation.account.transferNumber}
              class="rounded-full bg-primary-500 px-4 py-2 text-sm font-bold text-ink-900 transition-colors hover:bg-primary-400"
            >
              複製帳號
            </button>
          </dd>
          <p class="mt-2 text-xs leading-relaxed text-ink-300">
            跨行轉帳請輸入銀行代碼 {site.donation.account.bankCode}，帳號 {site.donation.account.transferNumber}（共 14 碼）
          </p>
        </div>
      </dl>

      <p class="mt-6 rounded-xl bg-accent-500/15 px-4 py-3 text-sm font-medium leading-relaxed text-accent-100">
        ⚠️ {site.donation.antiFraud}
      </p>

      <ul class="mt-4 list-disc space-y-1.5 pl-5 text-xs leading-relaxed text-ink-300">
        {site.donation.notes.map((note) => <li>{note}</li>)}
        <li>
          競選辦公室電話：
          <a href={`tel:${site.contact.phone}`} class="font-bold text-primary-400 underline">{site.contact.phone}</a>
        </li>
      </ul>
    </div>

    <!-- 志工招募表單 -->
    <div class="rounded-3xl border border-primary-200 bg-surface p-8 sm:p-10">
      <h2 class="text-2xl font-extrabold text-ink-900 sm:text-3xl">{site.volunteer.heading}</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-600">{site.volunteer.description}</p>

      <form
        id="volunteer-form"
        class="mt-8 space-y-5"
        data-mailto={site.contact.email}
        data-subject={site.volunteer.mailSubject}
        data-key={site.volunteer.web3formsKey}
      >
        <!-- 防垃圾訊息用的隱藏欄位，真人不會看到也不會勾 -->
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
        <div>
          <label for="volunteer-name" class="mb-1.5 block text-sm font-medium text-ink-700">姓名</label>
          <input
            id="volunteer-name"
            name="name"
            type="text"
            required
            placeholder="請輸入您的姓名"
            class="w-full rounded-lg border border-ink-200 px-4 py-2.5 text-sm focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-200"
          />
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="volunteer-phone" class="mb-1.5 block text-sm font-medium text-ink-700">聯絡電話</label>
            <input
              id="volunteer-phone"
              name="phone"
              type="tel"
              required
              placeholder="09xx-xxx-xxx"
              class="w-full rounded-lg border border-ink-200 px-4 py-2.5 text-sm focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-200"
            />
          </div>
          <div>
            <label for="volunteer-email" class="mb-1.5 block text-sm font-medium text-ink-700">Email</label>
            <input
              id="volunteer-email"
              name="email"
              type="email"
              placeholder="you@example.com"
              class="w-full rounded-lg border border-ink-200 px-4 py-2.5 text-sm focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-200"
            />
          </div>
        </div>

        <fieldset>
          <legend class="mb-2 text-sm font-medium text-ink-700">有興趣的參與方式</legend>
          <div class="flex flex-wrap gap-2">
            {
              site.volunteer.areas.map((area) => (
                <label class="flex cursor-pointer items-center gap-2 rounded-full border border-ink-200 px-3 py-1.5 text-sm text-ink-600 hover:border-primary-400">
                  <input type="checkbox" name="areas" value={area} class="accent-primary-500" />
                  {area}
                </label>
              ))
            }
          </div>
        </fieldset>

        <div>
          <label for="volunteer-message" class="mb-1.5 block text-sm font-medium text-ink-700">想對我們說的話（選填）</label>
          <textarea
            id="volunteer-message"
            name="message"
            rows="3"
            placeholder="歡迎留言"
            class="w-full rounded-lg border border-ink-200 px-4 py-2.5 text-sm focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-200"
          ></textarea>
        </div>

        <button
          type="submit"
          id="volunteer-submit"
          class="w-full rounded-full bg-primary-500 py-3.5 text-base font-bold text-ink-900 transition-colors hover:bg-primary-400 disabled:cursor-wait disabled:opacity-60"
        >
          送出報名
        </button>

        <p id="volunteer-status" class="hidden rounded-xl px-4 py-3 text-sm font-medium leading-relaxed" role="status"></p>

        <p class="text-xs leading-relaxed text-ink-400">
          {site.volunteer.note}如有問題，也可來電
          <a href={`tel:${site.contact.phone}`} class="font-bold text-ink-600 underline">{site.contact.phone}</a>。
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  // 「複製帳號」按鈕：複製 14 碼帳號，方便手機轉帳時直接貼上
  const copyButton = document.getElementById("copy-account");
  copyButton?.addEventListener("click", async () => {
    const label = copyButton.textContent;
    try {
      await navigator.clipboard.writeText(copyButton.dataset.copy ?? "");
      copyButton.textContent = "已複製 ✓";
    } catch {
      copyButton.textContent = "請手動複製";
    }
    setTimeout(() => (copyButton.textContent = label), 2000);
  });

  // 志工報名表單：網站沒有後端，透過 Web3Forms 把報名內容寄到競選團隊信箱
  const volunteerForm = document.getElementById("volunteer-form") as HTMLFormElement | null;
  const submitButton = document.getElementById("volunteer-submit") as HTMLButtonElement | null;
  const statusBox = document.getElementById("volunteer-status");

  const showStatus = (ok: boolean, html: string) => {
    if (!statusBox) return;
    statusBox.innerHTML = html;
    statusBox.className = `rounded-xl px-4 py-3 text-sm font-medium leading-relaxed ${
      ok ? "bg-primary-100 text-ink-900" : "bg-accent-100 text-accent-700"
    }`;
  };

  volunteerForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = new FormData(volunteerForm);
    if (data.get("botcheck")) return;

    const name = String(data.get("name") ?? "").trim();
    const payload = {
      access_key: volunteerForm.dataset.key,
      subject: `${volunteerForm.dataset.subject}－${name}`,
      from_name: "邱建富官網志工報名",
      姓名: name,
      聯絡電話: data.get("phone"),
      Email: data.get("email") || "（未填）",
      有興趣的參與方式: data.getAll("areas").join("、") || "（未選）",
      想對我們說的話: data.get("message") || "（未填）",
    };

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = "送出中…";
    }
    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(payload),
      });
      const result = await response.json();
      if (!result.success) throw new Error(result.message);
      volunteerForm.reset();
      showStatus(true, "✓ 報名已送出，謝謝您的支持！我們會盡快與您聯繫。");
    } catch {
      // 送出失敗時，改用郵件程式寄送，確保報名不會遺失
      const body = Object.entries(payload)
        .filter(([key]) => !["access_key", "subject", "from_name"].includes(key))
        .map(([key, value]) => `${key}：${value}`)
        .join("\n");
      const mailto =
        `mailto:${volunteerForm.dataset.mailto}` +
        `?subject=${encodeURIComponent(payload.subject)}&body=${encodeURIComponent(body)}`;
      showStatus(false, `送出失敗，請<a href="${mailto}" class="font-bold underline">改用 Email 寄送報名</a>，或直接來電。`);
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = "送出報名";
      }
    }
  });
</script>
