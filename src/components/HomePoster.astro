---
/*
  首頁宣傳海報：放在主視覺正下方。電腦版左海報、右文字重點，和上方主視覺的
  左文右圖交錯排列；手機版海報在上、文字在下。
  圖片與文字設定在 src/data/site.ts 的 homePoster；image 留空就不顯示這個區塊。
  海報完整顯示不裁切，點圖可開原圖放大。
*/
import { site } from "../data/site";
import { withBase } from "../utils/url";

const poster = site.homePoster;
---

{poster.image && (
  <section id="poster" class="border-y border-primary-100 bg-primary-50 py-12 sm:py-16">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8">
      <a
        href={withBase(poster.image)}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="放大查看宣傳海報"
        class="mx-auto block w-full max-w-md lg:max-w-none"
      >
        <img
          src={withBase(poster.image)}
          alt={poster.alt}
          width={poster.width}
          height={poster.height}
          decoding="async"
          class="h-auto w-full rounded-3xl shadow-xl"
        />
      </a>

      <div class="mx-auto w-full max-w-md lg:max-w-none">
        <h2 class="text-4xl font-extrabold text-ink-900 sm:text-5xl">{poster.heading}</h2>
        <p class="mt-3 text-3xl font-extrabold text-accent-600 sm:text-4xl">{poster.tagline}</p>

        <ul class="mt-8 space-y-4">
          {poster.points.map((point) => (
            <li class="flex items-start gap-4 rounded-2xl border-2 border-primary-200 bg-surface p-5 shadow-sm sm:p-6">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary-500 text-2xl font-extrabold text-ink-900 sm:h-12 sm:w-12" aria-hidden="true">✓</span>
              <div>
                <p class="text-2xl font-extrabold text-ink-900 sm:text-3xl">{point.title}</p>
                <p class="mt-2 text-xl font-bold leading-relaxed text-ink-800 sm:text-2xl">{point.text}</p>
              </div>
            </li>
          ))}
        </ul>

        <a
          href={poster.cta.href}
          class="mt-8 inline-block rounded-full bg-accent-500 px-8 py-3.5 text-base font-bold text-white shadow-lg shadow-accent-500/30 transition-transform hover:scale-105 hover:bg-accent-600"
        >
          {poster.cta.label}
        </a>
      </div>
    </div>
  </section>
)}
