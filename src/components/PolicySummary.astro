---
import { withBase } from "../utils/url";

// 政見總表：整理自公辦電視政見發表會（第 20 屆縣長選舉），內容為候選人親口說明的政見。
// 首頁直接顯示圖卡（public/images/2026-11-23-policy-summary-card.png，1080x1920），
// 下方文字版供搜尋引擎與螢幕閱讀器使用；改政見時圖卡與文字要一起更新。
const card = "/images/2026-11-23-policy-summary-card.png";
const groups = [
  {
    no: "一",
    title: "產業轉型：從低薪走向高薪",
    items: [
      ["爭取台積電進駐彰化", "目標 2030 年台積電到彰化設廠，積極爭取"],
      ["興建海水淡化廠", "每天產水 10 萬噸，補足中科二林園區每天 14 萬噸用水"],
      ["提升勞工薪資", "拿政府補助的企業要替員工加薪，擺脫全國最低薪"],
      ["增加工業用地", "增加供給讓地價下降，吸引製造業投資"],
    ],
  },
  {
    no: "二",
    title: "交通建設",
    items: [
      ["推動彰化市鐵路高架化", "2018 年核定至今原地踏步，要積極爭取、馬上推動"],
      ["雙鐵共構", "台鐵田中站與高鐵彰化站共構，帶進南投觀光客"],
    ],
  },
  {
    no: "三",
    title: "都市計畫與居住",
    items: [
      ["社會住宅", "4 年蓋 1000 戶，第一期先蓋 200 戶"],
      ["活化閒置空間", "閒置校地透過都市計畫、市地重劃改建住宅"],
      ["青銀共居", "年輕人留在彰化沒有房價壓力，也能和長輩同住"],
    ],
  },
  {
    no: "四",
    title: "五吉幸福・彰化共富",
    items: [
      ["健保費免費", "65 歲以上長輩、6 歲以下幼童由縣府負擔"],
      ["幸福長青卡加碼", "1000 點提高到 2000 點，每月不歸零"],
      ["12 年營養午餐免費", "從國中延長到高中"],
      ["縣立托嬰中心", "托育量能升級"],
      ["24 小時臨托中心", "設置 24 小時臨時托育中心"],
    ],
  },
  {
    no: "五",
    title: "農業・文化・觀光",
    items: [
      ["農業 AI 品牌化", "鼓勵青年返鄉，建立農產品牌、擴展行銷"],
      ["兩座大型圖書館", "提升閱讀力"],
      ["青年孵化與設計中心", "設在高鐵彰化站，培養創造力與品牌力"],
      ["國慶煙火、台灣燈會", "爭取到彰化舉辦"],
    ],
  },
  {
    no: "六",
    title: "長輩就醫交通・偏鄉醫療關懷",
    items: [
      ["強化社區關懷據點", "增加課程與服務，長輩更健康、少生病"],
      ["行動診所", "協調大醫院定期到偏鄉看診"],
      ["單一叫車專線", "計程車、Uber 聯合簽約，一通電話就叫得到車"],
      ["九人座巴士與公車補助", "固定載長輩到診所、醫院"],
      ["區域型診所", "人口 4 萬以上鄉鎮或分區設立"],
    ],
  },
];
---

<section id="policy-summary" class="bg-primary-50 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="inline-block rounded-full bg-primary-100 px-4 py-1 text-sm font-bold text-primary-800">彰化縣長候選人 ③ 邱建富</p>
      <h2 class="mt-4 text-3xl font-extrabold text-ink-900 sm:text-4xl">政見總表</h2>
      <p class="mt-4 text-lg text-ink-600">六大方向，一次看懂。整理自公辦電視政見發表會。</p>
    </div>

    <div class="mt-10 flex justify-center">
      <img
        src={withBase(card)}
        alt="彰化縣長候選人 ③ 邱建富政見圖卡：產業轉型、交通建設、安心居住、五吉幸福、農業文化觀光、長輩就醫偏鄉關懷六大政見"
        width="1080"
        height="1920"
        loading="lazy"
        decoding="async"
        class="h-auto w-full max-w-md rounded-3xl shadow-xl sm:max-w-lg"
      />
    </div>

    <div class="mt-8 flex flex-col items-center gap-3 text-center">
      <a
        href={withBase(card)}
        download="邱建富政見圖卡.png"
        class="inline-flex items-center gap-2 rounded-full bg-[#7a1e45] px-8 py-4 text-lg font-bold text-white shadow-md transition hover:bg-[#5a1a36]"
      >
        下載政見圖卡
      </a>
      <p class="text-sm text-ink-500">存到手機就能用 LINE 分享給親友・<a class="underline hover:text-ink-800" href={withBase("/policies")}>看完整政見說明</a></p>
    </div>

    <details class="mx-auto mt-8 max-w-5xl rounded-2xl border border-primary-200 bg-surface px-6 py-4">
      <summary class="cursor-pointer text-lg font-bold text-ink-800">文字版政見總表</summary>
      <div class="mt-4 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          groups.map((group) => (
            <article>
              <h3 class="text-lg font-extrabold text-[#7a1e45]">{group.no}、{group.title}</h3>
              <ul class="mt-2 space-y-2">
                {group.items.map(([name, desc]) => (
                  <li class="text-base leading-relaxed text-ink-700">
                    <span class="font-bold text-ink-900">{name}</span>：{desc}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </details>
  </div>
</section>
