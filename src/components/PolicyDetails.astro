---
import { getCollection, render } from "astro:content";

interface Props {
  showHighlights?: boolean; // 首頁上方的 PolicyGrid 已列出條列重點，這裡只放內文；/policies 頁面兩者都顯示
}

const { showHighlights = true } = Astro.props;

// 內容來自 src/content/policies/，全部直接顯示，不需要點開
const policies = (await getCollection("policies")).sort((a, b) => a.data.order - b.data.order);
const details = await Promise.all(
  policies.map(async (policy) => ({ policy, Content: (await render(policy)).Content })),
);
---

<section id="policy-details" class="bg-surface-alt py-20">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold text-ink-900 sm:text-4xl">核心政見詳細內容</h2>
      <p class="mt-4 text-ink-600">每項政見的具體做法與執行方向</p>
    </div>

    <div class="mt-14 space-y-6">
      {
        details.map(({ policy, Content }) => (
          <article class="rounded-3xl border border-primary-100 bg-surface p-6 shadow-sm sm:p-8">
            <h3 class="text-xl font-bold text-ink-900 sm:text-2xl">
              <span class="mr-2">{policy.data.icon}</span>{policy.data.title}
            </h3>
            <div class="prose mt-4 max-w-none text-base leading-relaxed text-ink-700">
              <Content />
            </div>

            {showHighlights && policy.data.highlights && (
              <ul class="mt-5 space-y-2 border-t border-primary-100 pt-5">
                {policy.data.highlights.map((item) => (
                  <li class="flex gap-2 text-base text-ink-700">
                    <span class="mt-0.5 text-primary-500">●</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
