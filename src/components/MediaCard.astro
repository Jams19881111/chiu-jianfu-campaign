---
import type { CollectionEntry } from "astro:content";

interface Props {
  item: CollectionEntry<"media">;
}

const { item } = Astro.props;
const sourceUrl = new URL(item.data.url);
const youtubeCandidate = ["youtube.com", "www.youtube.com", "m.youtube.com"].includes(sourceUrl.hostname)
  ? sourceUrl.searchParams.get("v")
  : sourceUrl.hostname === "youtu.be" ? sourceUrl.pathname.slice(1) : null;
const youtubeEmbed = youtubeCandidate && /^[A-Za-z0-9_-]{11}$/.test(youtubeCandidate)
  ? `https://www.youtube-nocookie.com/embed/${youtubeCandidate}` : undefined;
const facebookId = ["facebook.com", "www.facebook.com"].includes(sourceUrl.hostname)
  ? sourceUrl.pathname.match(/\/(?:reel|videos)\/(\d+)\/?$/)?.[1]
  : undefined;
const facebookEmbed = facebookId
  ? `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(item.data.url)}&show_text=false&width=450&height=600`
  : undefined;

const typeIcon: Record<string, string> = {
  "YouTube影片": "▶️",
  "Podcast": "🎙️",
  "其他影音": "🎬",
};
---

{sourceUrl.pathname.endsWith('.mp4') ? (
  <article class="overflow-hidden rounded-2xl border border-primary-100 bg-surface shadow-sm">
    <video controls playsinline preload="metadata" aria-label={item.data.title}
      style="display:block;width:100%;aspect-ratio:3/4;background:#181818;object-fit:contain;">
      <source src={item.data.url} type="video/mp4" />
      您的瀏覽器不支援影片播放，請使用下方連結觀看。
    </video>
    <div class="p-5">
      <span class="text-xs font-bold text-primary-600">{item.data.source}</span>
      <h3 class="mt-2 text-base font-bold text-ink-900">{item.data.title}</h3>
      <a href={item.data.url} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block text-sm font-bold text-primary-600 underline">開啟影片 →</a>
    </div>
  </article>
) : youtubeEmbed ? (
  <article class="overflow-hidden rounded-2xl border border-primary-100 bg-surface shadow-sm">
    <iframe src={youtubeEmbed} title={item.data.title} width="450" height="600"
      style="display:block;width:100%;height:auto;aspect-ratio:3/4;border:0;background:#181818;"
      loading="lazy" referrerpolicy="strict-origin-when-cross-origin"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen />
    <div class="p-5">
      <span class="text-xs font-bold text-primary-600">YouTube・{item.data.source}</span>
      <h3 class="mt-2 text-base font-bold text-ink-900">{item.data.title}</h3>
      <a href={item.data.url} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block text-sm font-bold text-primary-600 underline">前往 YouTube 觀看 →</a>
    </div>
  </article>
) : facebookEmbed ? (
  <article class="overflow-hidden rounded-2xl border border-primary-100 bg-surface shadow-sm">
    <iframe src={facebookEmbed} title={item.data.title} width="450" height="600"
      style="display:block;width:100%;height:auto;aspect-ratio:3/4;border:0;background:#181818;"
      loading="lazy" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen />
    <div class="p-5">
      <span class="text-xs font-bold text-primary-600">Facebook Reel・{item.data.source}</span>
      <h3 class="mt-2 text-base font-bold text-ink-900">{item.data.title}</h3>
      <a href={item.data.url} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block text-sm font-bold text-primary-600 underline">前往 Facebook 觀看 →</a>
    </div>
  </article>
) : (<a
  href={item.data.url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex flex-col overflow-hidden rounded-2xl border border-primary-100 bg-surface shadow-sm transition-shadow hover:shadow-md"
>
  <div class="flex aspect-video items-center justify-center bg-ink-900">
    <span class="text-4xl">{typeIcon[item.data.type] ?? "🎬"}</span>
  </div>
  <div class="p-5">
    <span class="text-xs font-bold text-primary-600">{item.data.type}・{item.data.source}</span>
    <h3 class="mt-2 text-base font-bold text-ink-900 group-hover:text-primary-700">
      {item.data.title}
    </h3>
  </div>
</a>)}
