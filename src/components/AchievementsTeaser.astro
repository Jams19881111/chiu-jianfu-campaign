---
import { getCollection } from "astro:content";
import { withBase } from "../utils/url";

const all = await getCollection("achievements");
// 首頁只挑幾個最有份量的數字當亮點，完整清單在 /achievements 頁面
const featuredIds = ["03-railway", "09-satisfaction", "02-legacy-cases"];
const featured = featuredIds
  .map((id) => all.find((a) => a.id === id))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));
---

<section id="achievements" class="bg-primary-800 py-20 text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-bold text-primary-200">2010–2018・彰化市長任內</p>
      <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">說到做到，九年施政成果</h2>
      <p class="mt-4 text-primary-100">不只是政見，過去九年市長任內已經證明過一次。</p>
    </div>

    <div class="mx-auto mt-10 max-w-md">
      <a href={withBase("/images/chiu-executive-experience.jpg")} target="_blank" rel="noopener noreferrer" class="block" aria-label="放大查看政績圖卡">
        <img src={withBase("/images/chiu-executive-experience.jpg")} alt="政績圖卡：做過首長，才知道怎麼做縣長。縣長、市長都要帶領公務團隊、編列並執行預算，立委不用。邱建富當過兩任彰化市長（2010–2018）、兩屆彰化縣議員。市長任內：20年以上懸案40項解決37項、2017年施政滿意度89.1%、彰化鐵路高架化387億定案、台中捷運延伸彰化139億定案。" width="1080" height="1350" loading="lazy" decoding="async" class="h-auto w-full rounded-2xl shadow-xl" />
      </a>
      <p class="mt-3 text-center text-sm text-primary-100">點圖可放大、存下來轉傳給親友</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        featured.map((item) => (
          <div class="rounded-2xl border border-primary-600/60 bg-primary-900/40 p-8 text-center">
            <p class="text-4xl font-extrabold text-primary-200">{item.data.metric}</p>
            <p class="mt-3 text-base font-bold">{item.data.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-primary-100">{item.data.summary}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <a
        href={withBase("/achievements")}
        class="inline-block rounded-full bg-white px-8 py-3.5 text-base font-bold text-primary-800 transition-transform hover:scale-105 hover:bg-primary-50"
      >
        查看完整施政成果里程碑 →
      </a>
    </div>
  </div>
</section>
