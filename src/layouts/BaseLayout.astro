---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { withBase } from "../utils/url";

interface Props {
  title: string;
  description?: string;
}

const { title, description = `邱建富官方網站。2026彰化縣長候選人、前彰化市長，了解經歷、施政成果、核心政見、最新消息與影音。${site.hero.slogan}。` } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const pagePath = basePath && Astro.url.pathname.startsWith(`${basePath}/`)
  ? Astro.url.pathname.slice(basePath.length) : Astro.url.pathname;
const canonicalUrl = new URL(pagePath, "https://chiuchienfu.tw");
const indexable = Astro.site?.hostname === "chiuchienfu.tw" && !pagePath.startsWith("/regions/");
const pageTitle = title === "首頁"
  ? `邱建富官網｜${site.candidate.role}・前彰化市長`
  : `${title} ｜ 邱建富官網`;
const websiteIdentity = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://chiuchienfu.tw/#website",
  name: "邱建富官網",
  alternateName: ["邱建富官方網站", "邱建富"],
  url: "https://chiuchienfu.tw/",
  inLanguage: "zh-Hant",
  about: {
    "@type": "Person",
    name: site.candidate.name,
    url: "https://chiuchienfu.tw/",
    image: "https://chiuchienfu.tw/images/candidate-hero.jpg",
    sameAs: [site.social.facebook, site.social.instagram].filter(url => url.startsWith("https://")),
  },
};
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? "index, follow" : "noindex, follow"} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="邱建富官網" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://chiuchienfu.tw/images/candidate-hero.jpg" />
    {indexable && pagePath === "/" && (
      <script type="application/ld+json" set:html={JSON.stringify(websiteIdentity).replace(/</g, "\\u003c")} />
    )}
    <title>{pageTitle}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
