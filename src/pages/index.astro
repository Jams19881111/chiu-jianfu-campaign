---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import HomePoster from "../components/HomePoster.astro";
import EventPromo from "../components/EventPromo.astro";
import FeaturedVideo from "../components/FeaturedVideo.astro";
import About from "../components/About.astro";
import AchievementsTeaser from "../components/AchievementsTeaser.astro";
import PolicyGrid from "../components/PolicyGrid.astro";
// 政見總表圖卡（src/components/PolicySummary.astro）暫時下架整理中，要放回來時加回 import 與 <PolicySummary />
import PolicyDetails from "../components/PolicyDetails.astro";
import NewsSection from "../components/NewsSection.astro";
import MediaSection from "../components/MediaSection.astro";
import DonationVolunteer from "../components/DonationVolunteer.astro";
---

<BaseLayout title="首頁">
  <Hero />
  <FeaturedVideo />
  <EventPromo />
  <HomePoster />
  <PolicyGrid />
  <AchievementsTeaser />
  <PolicyDetails showHighlights={false} />
  <NewsSection />
  <MediaSection />
  <About compact />
  <DonationVolunteer />
</BaseLayout>
